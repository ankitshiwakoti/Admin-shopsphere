function updateTable(tableId, data, columns) {
    try {
        const table = $(`#${tableId}`).DataTable();
        table.clear();
        if (data && data.length > 0) {
            table.rows.add(data).draw();
        }
    } catch (error) {
        console.error(`Error updating table ${tableId}:`, error);
    }
}
