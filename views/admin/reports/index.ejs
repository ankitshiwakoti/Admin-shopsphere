function updateSalesChart(data) {
    if (!data) {
        console.error('No sales data received');
        return;
    }

    try {
        // Update summary statistics
        if (data.summary) {
            document.getElementById('totalRevenue').textContent = `$${(data.summary.totalRevenue || 0).toFixed(2)}`;
            document.getElementById('totalOrders').textContent = data.summary.totalOrders || 0;
            document.getElementById('avgOrderValue').textContent = `$${(data.summary.averageOrderValue || 0).toFixed(2)}`;
            document.getElementById('totalItemsSold').textContent = data.summary.totalItemsSold || 0;
        }

        // Update main sales chart
        if (data.salesData && salesChart) {
            const labels = data.salesData.map(item => {
                const date = new Date(item._id.year, item._id.month - 1, item._id.day);
                return date.toLocaleDateString();
            });

            salesChart.data.labels = labels;
            salesChart.data.datasets[0].data = data.salesData.map(item => item.totalSales || 0);
            salesChart.update();
        }

        // Update category sales chart
        if (data.categorySales && categorySalesChart) {
            categorySalesChart.data.labels = data.categorySales.map(item => item._id || 'Unknown');
            categorySalesChart.data.datasets[0].data = data.categorySales.map(item => item.totalSales || 0);
            categorySalesChart.update();
        }

        // Update payment methods chart
        if (data.paymentMethods && paymentMethodsChart) {
            paymentMethodsChart.data.labels = data.paymentMethods.map(item => item._id || 'Unknown');
            paymentMethodsChart.data.datasets[0].data = data.paymentMethods.map(item => item.count || 0);
            paymentMethodsChart.update();
        }

        // Update sales table
        const salesTableBody = document.getElementById('salesReportContent');
        if (salesTableBody && data.salesData) {
            salesTableBody.innerHTML = '';
            data.salesData.forEach(item => {
                const date = new Date(item._id.year, item._id.month - 1, item._id.day);
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${date.toLocaleDateString()}</td>
                    <td>${item.orderCount || 0}</td>
                    <td>$${(item.totalSales || 0).toFixed(2)}</td>
                    <td>$${(item.avgOrderValue || 0).toFixed(2)}</td>
                    <td>${item.itemsSold || 0}</td>
                `;
                salesTableBody.appendChild(row);
            });
        }
    } catch (error) {
        console.error('Error updating sales charts:', error);
        showError('Failed to update sales charts');
    }
}

function updateInventoryChart(data) {
    if (!data) {
        console.error('No inventory data received');
        return;
    }

    try {
        // Update summary statistics
        if (data.summary) {
            document.getElementById('totalInventoryValue').textContent = `$${(data.summary.totalInventoryValue || 0).toFixed(2)}`;
            document.getElementById('lowStockItems').textContent = data.summary.lowStockCount || 0;
            document.getElementById('averageStockLevel').textContent = (data.summary.averageStockLevel || 0).toFixed(2);
            document.getElementById('totalProducts').textContent = data.summary.totalProducts || 0;
        }

        // Update inventory level chart
        if (data.inventoryData && inventoryLevelChart) {
            inventoryLevelChart.data.labels = data.inventoryData.map(item => item.name || 'Unknown');
            inventoryLevelChart.data.datasets[0].data = data.inventoryData.map(item => item.stock || 0);
            inventoryLevelChart.update();
        }

        // Update inventory value chart
        if (data.inventoryData && inventoryValueChart) {
            inventoryValueChart.data.labels = data.inventoryData.map(item => item.name || 'Unknown');
            inventoryValueChart.data.datasets[0].data = data.inventoryData.map(item => item.totalValue || 0);
            inventoryValueChart.update();
        }

        // Update inventory table
        const tableBody = document.getElementById('inventoryTableBody');
        if (tableBody && data.inventoryData) {
            tableBody.innerHTML = '';
            data.inventoryData.forEach(item => {
                const status = getStockStatus(item.stock || 0);
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${item.name || 'Unknown'}</td>
                    <td>${item.category || 'Uncategorized'}</td>
                    <td>${item.stock || 0}</td>
                    <td>$${(item.price || 0).toFixed(2)}</td>
                    <td>$${(item.totalValue || 0).toFixed(2)}</td>
                    <td>${item.totalSold || 0}</td>
                    <td><span class="badge bg-${status.color}">${status.label}</span></td>
                `;
                tableBody.appendChild(row);
            });
        }
    } catch (error) {
        console.error('Error updating inventory charts:', error);
        showError('Failed to update inventory charts');
    }
}

function updateCustomerChart(data) {
    if (!data) {
        console.error('No customer data received');
        return;
    }

    try {
        // Update summary statistics
        if (data.summary) {
            document.getElementById('totalCustomers').textContent = data.summary.totalCustomers || 0;
            document.getElementById('avgCustomerSpent').textContent = `$${(data.summary.averageSpent || 0).toFixed(2)}`;
            document.getElementById('avgOrderFrequency').textContent = `${((data.summary.averageOrderValue || 0)).toFixed(1)} days`;
        }

        // Update customer segments chart
        if (data.summary && data.summary.segments && customerSegmentsChart) {
            const segments = data.summary.segments;
            customerSegmentsChart.data.datasets[0].data = [
                segments.highValue || 0,
                segments.mediumValue || 0,
                segments.lowValue || 0
            ];
            customerSegmentsChart.update();
        }

        // Update customer acquisition chart
        if (data.acquisitionData && acquisitionChart) {
            const labels = data.acquisitionData.map(item => {
                if (item._id && item._id.year && item._id.month) {
                    return `${item._id.year}-${String(item._id.month).padStart(2, '0')}`;
                }
                return 'Unknown';
            });

            acquisitionChart.data.labels = labels;
            acquisitionChart.data.datasets[0].data = data.acquisitionData.map(item => item.count || 0);
            acquisitionChart.update();
        }

        // Update main customer chart based on report type
        const customerChartCtx = document.getElementById('customerChart');
        if (customerChartCtx && data.customerData) {
            // Clear previous chart if exists
            if (window.mainCustomerChart) {
                window.mainCustomerChart.destroy();
            }

            let chartData;
            const reportType = data.reportType || 'purchases';
            
            switch (reportType) {
                case 'purchases':
                    chartData = {
                        labels: data.customerData.map(c => c.name || 'Unknown'),
                        datasets: [{
                            label: 'Total Spent',
                            data: data.customerData.map(c => c.totalSpent || 0),
                            backgroundColor: 'rgba(75, 192, 192, 0.2)',
                            borderColor: 'rgb(75, 192, 192)',
                            borderWidth: 1
                        }]
                    };
                    break;
                case 'activity':
                    chartData = {
                        labels: data.customerData.map(c => c.name || 'Unknown'),
                        datasets: [{
                            label: 'Order Frequency (days)',
                            data: data.customerData.map(c => c.daysSinceLastPurchase || 0),
                            backgroundColor: 'rgba(54, 162, 235, 0.2)',
                            borderColor: 'rgb(54, 162, 235)',
                            borderWidth: 1
                        }]
                    };
                    break;
                case 'demographics':
                    chartData = {
                        labels: ['High Value', 'Medium Value', 'Low Value'],
                        datasets: [{
                            label: 'Customer Segments',
                            data: [
                                data.customerData.filter(c => c.segment === 'High Value').length,
                                data.customerData.filter(c => c.segment === 'Medium Value').length,
                                data.customerData.filter(c => c.segment === 'Low Value').length
                            ],
                            backgroundColor: [
                                'rgba(75, 192, 192, 0.6)',
                                'rgba(255, 206, 86, 0.6)',
                                'rgba(255, 99, 132, 0.6)'
                            ],
                            borderColor: [
                                'rgb(75, 192, 192)',
                                'rgb(255, 206, 86)',
                                'rgb(255, 99, 132)'
                            ],
                            borderWidth: 1
                        }]
                    };
                    break;
                case 'retention':
                    chartData = {
                        labels: data.customerData.map(c => c.name || 'Unknown'),
                        datasets: [{
                            label: 'Days Since Last Purchase',
                            data: data.customerData.map(c => c.daysSinceLastPurchase || 0),
                            backgroundColor: 'rgba(153, 102, 255, 0.2)',
                            borderColor: 'rgb(153, 102, 255)',
                            borderWidth: 1
                        }]
                    };
                    break;
                default:
                    chartData = {
                        labels: data.customerData.map(c => c.name || 'Unknown'),
                        datasets: [{
                            label: 'Total Orders',
                            data: data.customerData.map(c => c.totalOrders || 0),
                            backgroundColor: 'rgba(255, 206, 86, 0.2)',
                            borderColor: 'rgb(255, 206, 86)',
                            borderWidth: 1
                        }]
                    };
            }

            window.mainCustomerChart = new Chart(customerChartCtx, {
                type: reportType === 'demographics' ? 'pie' : 'bar',
                data: chartData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    },
                    scales: reportType === 'demographics' ? {} : {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    if (reportType === 'purchases') {
                                        return '$' + value.toFixed(2);
                                    }
                                    return value;
                                }
                            }
                        }
                    }
                }
            });
        }

        // Update customer table
        const tableBody = document.getElementById('customerReportContent');
        if (tableBody && data.customerData) {
            tableBody.innerHTML = '';
            data.customerData.forEach(customer => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${customer.name || 'Unknown'}</td>
                    <td>${customer.totalOrders || 0}</td>
                    <td>$${(customer.totalSpent || 0).toFixed(2)}</td>
                    <td>$${(customer.averageOrderValue || 0).toFixed(2)}</td>
                    <td>${customer.daysSinceLastPurchase || 0} days</td>
                    <td>${customer.lastPurchase ? new Date(customer.lastPurchase).toLocaleDateString() : 'Never'}</td>
                `;
                tableBody.appendChild(row);
            });
        }
    } catch (error) {
        console.error('Error updating customer charts:', error);
        showError('Failed to update customer charts');
    }
}

function getStockStatus(stock) {
    if (stock <= 5) return { color: 'danger', label: 'Critical' };
    if (stock <= 10) return { color: 'warning', label: 'Low' };
    if (stock <= 20) return { color: 'info', label: 'Moderate' };
    return { color: 'success', label: 'Good' };
}

function getCustomerStatus(customer) {
    if (!customer.totalOrders) return { color: 'secondary', label: 'New' };
    if (customer.totalOrders > 10) return { color: 'success', label: 'VIP' };
    if (customer.totalOrders > 5) return { color: 'primary', label: 'Regular' };
    return { color: 'info', label: 'Occasional' };
}

