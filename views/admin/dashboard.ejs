
<div class="container-fluid px-2">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Dashboard Overview</h1>
    </div>

    <!-- Content Row -->
    <div class="row g-2">
        <!-- Products Card -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-left-primary shadow h-100  px-2 py-2 dashboard-card stat-card">
                <div class="card-body px-2 px-sm-3">
                    <div class="row no-gutters align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Products</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= data.counts.products %></div>
                            <div class="text-xs text-body-light mt-2">
                                <i class="fas fa-box me-1"></i>Total Products
                            </div>
                        </div>
                        <div class="col-auto pe-2">
                            <i class="fas fa-box stat-icon text-gray-300" style="color: var(--color-primary);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Card -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-left-success shadow h-100 py-2 dashboard-card stat-card">
                <div class="card-body px-2 px-sm-3">
                    <div class="row no-gutters align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Monthly Revenue</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">$<%= data.revenue.monthly.toFixed(2) %></div>
                            <div class="text-xs text-body-light mt-2">
                                <i class="fas fa-dollar-sign me-1"></i>Today: $<%= data.revenue.today.toFixed(2) %>
                            </div>
                        </div>
                        <div class="col-auto pe-2">
                            <i class="fas fa-dollar-sign stat-icon text-gray-300" style="color: var(--color-success);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Orders Card -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-left-info shadow h-100 py-2 dashboard-card stat-card">
                <div class="card-body px-2 px-sm-3">
                    <div class="row no-gutters align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold  text-uppercase mb-1" style="color: #0b49ae;">Orders</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= data.counts.orders %></div>
                            <div class="text-xs text-body-light mt-2">
                                <% const pendingOrders = data.charts.orderStatus.find(s => s._id === 'pending')?.count || 0 %>
                                <i class="fas fa-clock me-1"></i><%= pendingOrders %> Pending Orders
                            </div>
                        </div>
                        <div class="col-auto pe-2">
                            <i class="fas fa-shopping-cart stat-icon text-gray-300" style="color: #0b49ae;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customers Card -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-left-warning shadow h-100 py-2 dashboard-card stat-card">
                <div class="card-body px-2 px-sm-3">
                    <div class="row no-gutters align-items-center">
                        <div class="col">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Customers</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"><%= data.counts.customers %></div>
                            <div class="text-xs text-body-light mt-2">
                                <i class="fas fa-users me-1"></i>Total Registered
                            </div>
                        </div>
                        <div class="col-auto pe-2">
                            <i class="fas fa-users stat-icon text-warning-300" style="color: var(--color-warning);"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row -->
    <div class="row g-2 mt-3">
        <!-- Recent Orders -->
        <div class="col-12 col-lg-8">
            <div class="card shadow mb-4 dashboard-card">
                <div class="card-header py-3 d-flex flex-column flex-md-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Orders</h6>
                    <a href="/admin/orders" class="btn btn-sm btn-primary mt-2 mt-md-0">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr class="bg-light">
                                    <th class="px-2 px-sm-3 py-3">Order ID</th>
                                    <th class="px-2 px-sm-3 py-3 d-none d-md-table-cell">Customer</th>
                                    <th class="px-2 px-sm-3 py-3">Amount</th>
                                    <th class="px-2 px-sm-3 py-3">Status</th>
                                    <th class="px-2 px-sm-3 py-3 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (data.recentOrders && data.recentOrders.length > 0) { %>
                                    <% data.recentOrders.forEach(order => { %>
                                        <tr>
                                            <td class="px-2 px-sm-3 py-3"><%= order.orderNumber %></td>
                                            <td class="px-2 px-sm-3 py-3 d-none d-md-table-cell">
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold"><%= order.user ? order.user.name : 'N/A' %></span>
                                                    <small class="text-muted"><%= order.user ? order.user.email : '' %></small>
                                                </div>
                                            </td>
                                            <td class="px-2 px-sm-3 py-3">$<%= order.total.toFixed(2) %></td>
                                            <td class="px-2 px-sm-3 py-3">
                                                <span class="badge <%= 
                                                    order.status === 'pending' ? 'bg-pending' :
                                                    order.status === 'processing' ? 'bg-processing' :
                                                    order.status === 'shipped' ? 'bg-shipped' :
                                                    order.status === 'delivered' ? 'bg-delivered' :
                                                    'bg-completed'
                                                %>">
                                                    <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <!-- <a href="/admin/orders/<%= order._id %>" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i>
                                                </a> -->
                                                <div class="dropdown">
                                                    <button class="btn btn-icon btn-sm btn-ghost rounded-circle" data-bs-toggle="dropdown">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <a class="dropdown-item" href="/admin/orders/<%= order._id %>">
                                                                <i class="fas fa-eye me-2"></i>View Details
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-3">No recent orders found</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="col-12 col-lg-4">
            <div class="card shadow mb-4 dashboard-card">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Order Statistics</h6>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="small font-weight-bold">Order Status Distribution</h6>
                        <% data.charts.orderStatus.forEach(status => { %>
                            <div class="mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small"><%= status._id.charAt(0).toUpperCase() + status._id.slice(1) %></span>
                                    <span class="small font-weight-bold"><%= status.count %> orders</span>
                                </div>
                                <div class="progress" style="height: 5px;">
                                    <div class="progress-bar <%= 
                                        status._id === 'pending' ? 'bg-orange' :
                                        status._id === 'processing' ? 'bg-primary' :
                                        status._id === 'shipped' ? 'bg-blue' :
                                        status._id === 'delivered' ? 'bg-green' :
                                        'bg-danger'
                                    %>" role="progressbar" style="width: <%= (status.count / data.counts.orders * 100).toFixed(1) %>%"></div>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <div class="mt-4">
                        <h6 class="small font-weight-bold">Low Stock Products</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Stock</th>
                                        <th>Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% data.lowStockProducts.forEach(product => { %>
                                        <tr>
                                            <td><%= product.name %></td>
                                            <td>
                                                <span class="badge <%= product.stock < 5 ? 'bg-outofstock' : 'bg-lowstock' %>">
                                                    <%= product.stock %>
                                                </span>
                                            </td>
                                            <td>$<%= product.price.toFixed(2) %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Toggle sidebar on mobile
    document.addEventListener('DOMContentLoaded', function() {
        const toggleButton = document.createElement('button');
        toggleButton.className = 'btn btn-primary d-md-none position-fixed top-0 end-0 m-3';
        toggleButton.innerHTML = '<i class="fas fa-bars"></i>';
        document.body.appendChild(toggleButton);

        toggleButton.addEventListener('click', function() {
            document.querySelector('.sidebar').classList.toggle('active');
        });
    });
</script> 