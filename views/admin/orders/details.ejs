

<div class="container-fluid py-3 px-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Order Details</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/admin/orders" style="color: var(--color-primary);">Orders</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Order #<%= order.orderNumber %></li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/orders/<%= order._id %>/invoice" class="btn btn-outline-primary">
                <i class="fas fa-file-invoice me-2"></i>Generate Invoice
            </a>
            <% if (order.status !== 'cancelled' && order.status !== 'delivered') { %>
                <button class="btn btn-danger" onclick="cancelOrder()">
                    <i class="fas fa-times me-2"></i>Cancel Order
                </button>
            <% } %>
        </div>
    </div>

    <div class="row">
        <!-- Order Summary -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Order Number</label>
                            <div class="fw-semibold"><%= order.orderNumber %></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Order Date</label>
                            <div class="fw-semibold"><%= new Date(order.createdAt).toLocaleString() %></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Status</label>
                            <div>
                                <span class="badge <%= 
                                    order.status === 'pending' ? 'bg-pending' :
                                    order.status === 'processing' ? 'bg-processing' :
                                    order.status === 'completed' ? 'bg-completed' :
                                    'bg-cancelled'
                                %>">
                                    <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Order Status</label>
                            <div>
                                <span class="badge <%= 
                                    order.orderStatus === 'pending' ? 'bg-pending' :
                                    order.orderStatus === 'processing' ? 'bg-processing' :
                                    order.orderStatus === 'shipped' ? 'bg-shipped' :
                                    order.orderStatus === 'delivered' ? 'bg-delivered' :
                                    'bg-cancelled'
                                %>">
                                    <%= order.orderStatus.charAt(0).toUpperCase() + order.orderStatus.slice(1) %>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Payment Status</label>
                            <div>
                                <span class="badge <%= 
                                    order.paymentStatus === 'paid' ? 'bg-paid' :
                                    order.paymentStatus === 'pending' ? 'bg-pending' :
                                    order.paymentStatus === 'refunded' ? 'bg-refunded' :
                                    'bg-completed'
                                %>">
                                    <%= order.paymentStatus.charAt(0).toUpperCase() + order.paymentStatus.slice(1) %>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Payment Method</label>
                            <div class="fw-semibold"><%= order.paymentMethod %></div>
                        </div>
                        <% if (order.trackingNumber) { %>
                            <div class="col-md-6">
                                <label class="form-label text-muted">Tracking Number</label>
                                <div class="fw-semibold"><%= order.trackingNumber %></div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Order Items -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Order Items</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.items.forEach(item => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="<%= item.product.images[0].url %>" 
                                                 alt="<%= item.product.name %>"
                                                 class="rounded"
                                                 width="48">
                                            <div class="ms-3">
                                                <div class="fw-semibold"><%= item.product.name %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end">$<%= item.price.toFixed(2) %></td>
                                    <td class="text-center"><%= item.quantity %></td>
                                    <td class="text-end">$<%= (item.price * item.quantity).toFixed(2) %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                        <tfoot class="bg-light">
                            <tr>
                                <td colspan="3" class="text-end">Subtotal:</td>
                                <td class="text-end">$<%= order.subtotal.toFixed(2) %></td>
                            </tr>
                            <% if (order.discount > 0) { %>
                                <tr>
                                    <td colspan="3" class="text-end">Discount:</td>
                                    <td class="text-end">-$<%= order.discount.toFixed(2) %></td>
                                </tr>
                            <% } %>
                            <tr>
                                <td colspan="3" class="text-end">Shipping:</td>
                                <td class="text-end">$<%= order.shippingCost.toFixed(2) %></td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end">Tax:</td>
                                <td class="text-end">$<%= order.tax.toFixed(2) %></td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total:</td>
                                <td class="text-end fw-bold">$<%= order.total.toFixed(2) %></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Customer & Shipping Info -->
        <div class="col-md-4">
            <!-- Customer Info -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Customer Information</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div>
                            <h6 class="mb-1"> <i class="fas fa-user me-2" style="color: var(--color-body-light-2);"></i><%= order.user.name %></h6>
                            <div class="text-muted"><%= order.user.email %></div>
                            <div class="text-muted"><%= order.user.phone %></div>
                        </div>
                    </div>
                    <a href="/admin/customers/<%= order.user._id %>" class="btn btn-outline-primary btn-sm w-100">
                        View Customer Profile
                    </a>
                </div>
            </div>

            <!-- Shipping Address -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Shipping Address</h5>
                </div>
                <div class="card-body">
                    <address class="mb-0"> <i class="fas fa-map-marker-alt me-2" style="color: var(--color-body-light-2);"></i>
                        <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %><br>
                        <%= order.shippingAddress.zipCode %><br>
                        <%= order.shippingAddress.country %>
                    </address>
                </div>
            </div>

            <!-- Update Status -->
            <% if (order.status !== 'cancelled' && order.orderStatus !== 'delivered') { %>
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Update Status</h5>
                    </div>
                    <div class="card-body">
                        <form id="updateStatusForm">
                            <div class="mb-3">
                                <label class="form-label">Status</label>
                                <select class="form-select" name="status" required>
                                    <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>Processing</option>
                                    <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                    <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Order Status</label>
                                <select class="form-select" name="orderStatus" required>
                                    <option value="pending" <%= order.orderStatus === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="processing" <%= order.orderStatus === 'processing' ? 'selected' : '' %>>Processing</option>
                                    <option value="shipped" <%= order.orderStatus === 'shipped' ? 'selected' : '' %>>Shipped</option>
                                    <option value="delivered" <%= order.orderStatus === 'delivered' ? 'selected' : '' %>>Delivered</option>
                                    <option value="cancelled" <%= order.orderStatus === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Tracking Number</label>
                                <input type="text" class="form-control" name="trackingNumber" value="<%= order.trackingNumber || '' %>">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Update Status</button>
                        </form>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Cancel Order Modal -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancel Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="cancelOrderForm">
                    <div class="mb-3">
                        <label class="form-label">Cancellation Reason</label>
                        <textarea class="form-control" name="notes" rows="3" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" form="cancelOrderForm" class="btn btn-danger">Cancel Order</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Handle status update
    document.getElementById('updateStatusForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        try {
            const response = await fetch('/admin/orders/<%= order._id %>/status', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    status: this.status.value,
                    orderStatus: this.orderStatus.value,
                    trackingNumber: this.trackingNumber.value
                })
            });

            const data = await response.json();
            
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Error updating order status');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error updating order status');
        }
    });

    // Handle order cancellation
    function cancelOrder() {
        const modal = new bootstrap.Modal(document.getElementById('cancelOrderModal'));
        modal.show();
    }

    document.getElementById('cancelOrderForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        try {
            const response = await fetch('/admin/orders/<%= order._id %>/cancel', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    notes: this.notes.value
                })
            });

            const data = await response.json();
            
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message || 'Error cancelling order');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Error cancelling order');
        }
    });
</script> 