

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Two-Factor Authentication</h4>
                </div>
                <div class="card-body">
                   
                    
                    <p class="text-muted">
                        Please enter the 6-digit code from your authenticator app or use one of your backup codes.
                    </p>

                    <form action="/admin/login" method="POST">
                        <!-- Hidden fields to preserve login data -->
                        <input type="hidden" name="email" value="<%= email %>">
                        <input type="hidden" name="password" value="<%= password %>">
                        
                        <div class="mb-3">
                            <label for="token" class="form-label">Authentication Code</label>
                            <input type="text" 
                                   class="form-control" 
                                   id="token" 
                                   name="token" 
                                   required 
                                   pattern="[0-9]{6}"
                                   maxlength="6"
                                   placeholder="Enter 6-digit code"
                                   autofocus>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Verify & Login</button>
                        </div>
                    </form>

                    <div class="mt-3 text-center">
                        <a href="/admin/login" class="text-muted">Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Auto-focus the token input
    document.getElementById('token').focus();
});
</script> 